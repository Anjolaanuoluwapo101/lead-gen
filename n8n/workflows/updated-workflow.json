    {
      "parameters": {
        "jsCode": "return {\n  // --- core (engine fills any blank from defaults) ---\n  seller_id: $json.seller.id,\n  keyword: 'medical instruments',\n  place: 'Surulere, Lagos',\n  niche: 'I sell medical instruments',\n  // --- how many / how strict ---\n  max_results: 6,\n  scrutiny: 'balanced', // 'strict' | 'balanced' | 'lenient'\n  // --- DataForSEO location pinning (bare Lagos-area names often resolve to 0) ---\n  location_name: null, // city/country, e.g. 'Lagos' when 'place' is a bare neighbourhood\n  location_code: null, // a DataForSEO code beats location_name whenever you have one\n  // --- resume / name the campaign ---\n  campaign_id: null, // resume an EXISTING campaign instead of a brand-new run\n  campaign_name: null, // friendly label for the new campaign\n  // --- enrichment depth (null = engine defaults) ---\n  enrich_max_count: null, // cap websites to crawl (default 12)\n  enrich_max_depth: null, // crawl link depth (default 1)\n  enrich_analyze_pages_limit: null, // pages analyzed per site\n  all_domains: false, // true = crawl whole domain; false = same-site only\n  // --- scoring ---\n  score_model: null, // e.g. 'groq' | 'openai' | 'openrouter' | 'anthropic'\n  score_extra_hints: null, // extra instructions injected into the scoring prompt\n  // --- optional social deep-fetch ---\n  social_platforms: null // e.g. ['facebook', 'instagram']\n};"
      },
