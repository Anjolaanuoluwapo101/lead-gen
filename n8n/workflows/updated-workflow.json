        "jsCode": "const leads = ($json.leads || []).map(l => ({\n  lead_id: l.id,\n  prospect_id: l.prospect_id,\n  business: l.business_name,\n  category: l.category,\n  phone: l.phone,\n  email: (Array.isArray(l.emails) ? l.emails : []).join(', '),\n  website: l.website,\n  score: l.opportunity_score,\n  qualified: l.qualified,\n  why: l.weakness,\n  first_line: l.first_line,\n  created_at: l.created_at\n}));\n// One row per pending lead to review. Feed a lead_id into the Draft flow.\nreturn leads;"
