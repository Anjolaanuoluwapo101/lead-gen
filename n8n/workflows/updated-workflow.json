        "jsCode": "const f = $('Seller config (form)').first().json || {};\nconst pick = (prefix) => {\n  const o = {};\n  ['provider','model','base_url','api_key','login','password'].forEach(k => {\n    const v = f[prefix + '_' + k];\n    if (v != null && String(v).trim() !== '') o[k] = String(v).trim();\n  });\n  return Object.keys(o).length ? o : null;\n};\nreturn {\n  seller_id: $json.seller.id,\n  llm: pick('llm'),\n  finder: pick('finder')\n};"
      },
