{
  "name": "Lead End-to-End: Campaign > Pull > Review > Mark",
  "nodes": [
    {
      "parameters": {},
      "id": "e2e-manual-trigger",
      "name": "Run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [140, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "inp-keyword",
              "name": "keyword",
              "value": "dentist",
              "type": "string"
            },
            {
              "id": "inp-place",
              "name": "place",
              "value": "Austin, TX",
              "type": "string"
            },
            {
              "id": "inp-niche",
              "name": "niche",
              "value": "adds online booking to dental clinics",
              "type": "string"
            },
            {
              "id": "inp-maxresults",
              "name": "max_results",
              "value": "6",
              "type": "number"
            },
            {
              "id": "inp-locationname",
              "name": "location_name",
              "value": "",
              "type": "string"
            },
            {
              "id": "inp-campaignid",
              "name": "campaign_id",
              "value": "",
              "type": "string"
            },
            {
              "id": "inp-scrutiny",
              "name": "scrutiny",
              "value": "strict",
              "type": "string"
            },
            {
              "id": "inp-sellerid",
              "name": "seller_id",
              "value": "",
              "type": "string"
            }
          ]
        }
      },
      "id": "e2e-campaign-params",
      "name": "Campaign Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/campaign",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "e2e-campaign-http",
      "name": "Run /campaign (find-enrich-score-store)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/leads",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ campaign_id: $json.campaign_id, scope: 'unprocessed' }) }}",
        "options": {}
      },
      "id": "e2e-pull-http",
      "name": "Pull /leads (new)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const out = $json;\nconst leads = (out.leads || []).map(l => ({\n  lead_id: l.id,\n  prospect_id: l.prospect_id,\n  business: l.business_name,\n  category: l.category,\n  phone: l.phone,\n  email: (Array.isArray(l.emails) ? l.emails : []).join(', '),\n  website: l.website,\n  score: l.opportunity_score,\n  qualified: l.qualified,\n  why: l.weakness,\n  first_line: l.first_line,\n  created_at: l.created_at\n}));\n// Each returned row is one pending lead to review.\nreturn leads;"
      },
      "id": "e2e-expand",
      "name": "Expand to review rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/leads/status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_ids: [$json.lead_id], status: 'contacted' }) }}",
        "options": {}
      },
      "id": "e2e-mark",
      "name": "Mark contacted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [1040, 300]
    }
  ],
  "connections": {
    "Run": {
      "main": [[{ "node": "Campaign Inputs", "type": "main", "index": 0 }]]
    },
    "Campaign Inputs": {
      "main": [[{ "node": "Run /campaign (find-enrich-score-store)", "type": "main", "index": 0 }]]
    },
    "Run /campaign (find-enrich-score-store)": {
      "main": [[{ "node": "Pull /leads (new)", "type": "main", "index": 0 }]]
    },
    "Pull /leads (new)": {
      "main": [[{ "node": "Expand to review rows", "type": "main", "index": 0 }]]
    },
    "Expand to review rows": {
      "main": [[{ "node": "Mark contacted", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
