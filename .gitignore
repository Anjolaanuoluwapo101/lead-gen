venv/
venv
docs
docs/

# Local dev artifacts (not part of the product)
node_modules/
n8n/node_modules/
drivers/
# Moved to the repo root for the same reason as .env: the CodeZip packager
# copies python-app/ wholesale and ignores .gitignore, so a Chrome profile
# (cookies + session state) must not live in there. Path updated in
# google_maps.py. The python-app/ entry is kept in case one is recreated.
.browser-profile/
python-app/.browser-profile/
python-app/outputs/
python-app/__pycache__/
python-app/.env
python-app/data/
*.csv

# Secrets now live OUTSIDE python-app/ on purpose: AgentCore's CodeZip packager
# copies codeLocation wholesale and does NOT exclude .env, so anything inside
# python-app/ would be uploaded to the deploy assets bucket. See the fallback
# loader in lead_engine.py / supabase_store.py / dataforseo.py / groq_ai.py /
# at_rest.py.
.env
.env.*

# AgentCore project (agentcore/ is committed; its build outputs are not)
agentcore/cdk/node_modules/
agentcore/cdk/cdk.out/
agentcore/cdk/dist/
agentcore/.cli/
agentcore/.cache/
agentcore/.env.local
agentcore/.cache/
agentcore/leading/
agentcore/leadgen/
# Bytecode and logs. These were tracked by accident and churn on every run.
__pycache__/
*.pyc
err.log

# Local scratch: the Day-0 AgentCore smoke test. Superseded by agentcore/.
agentcore-smoke/

# Dashboard deploy scratch: the source zip uploaded to S3 for CodeBuild, and the
# CLI policy documents written alongside it. Both are regenerated by
# deploy-dashboard.sh, so neither belongs in history. (buildsrc.zip is ~3MB, and
# committing a build input that is derived from the tree invites it going stale
# against the code it was built from.)
buildsrc.zip
.awstmp/

# Runtime state, not source: the id of the most recent local run, rewritten
# every time one starts.
python-app/.last_run_id
