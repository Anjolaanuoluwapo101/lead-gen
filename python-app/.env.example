# Copy this file to <repo-root>/.env and fill in your real values.
# NOTE THE LOCATION: .env lives in the REPO ROOT, not here. AgentCore's CodeZip
# packager copies python-app/ wholesale into the deploy assets bucket and does
# NOT read .gitignore, so a .env in this directory would be uploaded with the
# runtime. Every loader falls back to the parent directory for that reason.
# DataForSEO authenticates with HTTP Basic Auth using your account login
# (your email) + password. These are read from the environment (or .env) by
# dataforseo.py and app.py. Never commit the real .env.
DATAFORSEO_LOGIN=your@email.com
DATAFORSEO_PASSWORD=your-dataforseo-password
GROQ_API_KEY=gsk_your-key-here

# Optional platform MASTER keys — the fallback when a seller brings no key of
# their own (config.py: per-seller encrypted key > this env master). Groq is the
# default. Adding one of these alone makes that provider usable without any
# per-seller config; a seller who sets their own key in /seller/<id>/config
# overrides it.
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=

# Supabase (STORE stage). Project URL looks like https://abcd.supabase.co
# and the SERVICE_ROLE key (Settings -> API) bypasses RLS for internal writes.
# Never commit the real .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...your-service-role-key

# The PUBLISHABLE anon key, also from Settings -> API. Required, and a different
# key from the one above: the browser sends it to Supabase Auth directly to sign
# users in, and this server sends it to verify the resulting token
# (`GET /auth/v1/user`). It is public by design — it grants no row access on its
# own under RLS — but it is NOT the service key, and swapping them makes every
# token check fail.
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# ---------------------------------------------------------------------------
# Multi-tenant bridge (single-user fallback) — see docs/multi-tenant-plan.md.
# The uuid standing key of the ONE seller that pre-auth n8n runs map to, so a
# campaign/draft/read with no seller_id still lands on a real seller row. Since
# reads are now seller-scoped (required), SET THIS for the pre-auth bridge —
# otherwise /leads, /leads/status and /campaigns/summary return 400 (no seller
# to resolve). Leave blank once auth + frontend exist and every call carries a
# real seller_id.
#DEFAULT_SELLER_ID=

# Secrets-at-rest master key (Fernet). Per-seller API keys sent to
# PATCH /seller/<id>/config are encrypted with this BEFORE storage — they are
# NEVER stored plaintext. A DB reader without this key cannot read them. Protect
# it like the service key. Generate one with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, per-seller keys can't be saved (PATCH returns 503) and every seller
# falls back to the platform master keys below — non-secret config still works.
#CRED_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Social-profile enrichment (optional). When an operator picks platforms to
# deep-fetch (n8n "social_platforms"), these keys unlock richer data. Handlers
# AUTO-SKIP when a key is missing, so this is optional: no-key wins (WhatsApp
# number parse, X oEmbed, Telegram handle) still work.
#   YOUTUBE_API_KEY    -> https://console.cloud.google.com (YouTube Data API v3)
#   TELEGRAM_BOT_TOKEN -> from @BotFather
# ---------------------------------------------------------------------------
#YOUTUBE_API_KEY=
#TELEGRAM_BOT_TOKEN=

# JS-render escalation for walled socials (reuses the Playwright browser).
# When a platform's plain fetch comes back blocked/unverified AND it's in
# SOCIAL_JS_RENDER_PLATFORMS, social_enrich retries it in a headless browser.
# OFF by default (hosting). Default allowlist = the two where a browser clears a
# consent wall; extend the list to try others, e.g. facebook,pinterest,instagram.
# Enable per-platform is automatic once SOCIAL_JS_RENDER=true + listed here.
#ENRICH_JS_RENDER=false            # website-crawl hollow fallback (separate)
#SOCIAL_JS_RENDER=false            # master switch for social JS escalation
#SOCIAL_JS_RENDER_PLATFORMS=facebook,pinterest

# ---------------------------------------------------------------------------
# Scrutiny / data-quality tiers (strict | balanced | lenient).
# All tunable here — the engine reads these at run time. Defaults shown; uncomment
# and change what you want. Threshold = minimum score to qualify. accept_phone_only
# = whether a phone-reachable business (no website) may become a lead.
# HINT = instruction injected into the scoring prompt for that tier.
# ---------------------------------------------------------------------------
SCRUTINY_DEFAULT=strict

SCRUTINY_STRICT_THRESHOLD=70
SCRUTINY_STRICT_ACCEPT_PHONE_ONLY=false

SCRUTINY_BALANCED_THRESHOLD=55
SCRUTINY_BALANCED_ACCEPT_PHONE_ONLY=true

SCRUTINY_LENIENT_THRESHOLD=40
SCRUTINY_LENIENT_ACCEPT_PHONE_ONLY=true

# Optional per-tier scoring-prompt hints. If omitted the built-in defaults are used.
#SCRUTINY_STRICT_HINT=Be strict...
#SCRUTINY_BALANCED_HINT=...
#SCRUTINY_LENIENT_HINT=...

# ---------------------------------------------------------------------------
# Phase 1 -- two-score qualification (opportunity + confidence).
# score == opportunity_score, so the tier THRESHOLD above keeps its meaning.
# confidence_score is clamped to a deterministic cap from data quality (a thin
# scrape can never look high-confidence). By default qualification only uses
# opportunity (preserves prior behaviour). Turn on the confidence floor if you
# also want to refuse high-opportunity leads you're too unsure about.
# ---------------------------------------------------------------------------
#REQUIRE_CONFIDENCE_FLOOR=false
#CONFIDENCE_FLOOR=30

# ---------------------------------------------------------------------------
# Headless JS-render fallback (Playwright). OFF by default so lean containers
# don't need a browser. Turn on ONLY where you've already installed it:
#     pip install playwright
#     playwright install chromium
# When on, only pages whose raw HTML "looks hollow" (JS-driven shells with no
# real text) are rendered headlessly so emails/socials can be found there.
# ---------------------------------------------------------------------------
ENRICH_JS_RENDER=false

# ---------------------------------------------------------------------------
# Agent backend — which executor owns a run started from the dashboard.
#
#   local      (default) an in-process daemon thread. Needs nothing deployed.
#   agentcore  POST /invocations on the deployed runtime; needs BOTH vars below.
#
# Both write progress to the same `runs` row, so the dashboard's live progress,
# event log and stop reason work identically either way — this flips the demo
# between them rather than choosing one. An unrecognised value is refused
# rather than quietly falling back, so a typo cannot make the local path look
# like AWS.
#
# Cancel works on both, by different mechanisms: locally via an in-process
# Event, remotely via runs.cancel_requested (the runtime reads it between
# turns). Both have the same granularity — an in-flight model call finishes.
# ---------------------------------------------------------------------------
#AGENT_BACKEND=local
#AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/leadgen_leadgen-XXXXXXXXXX
#AGENTCORE_REGION=us-west-2

# ---------------------------------------------------------------------------
# DEPLOYED RUNTIME ONLY — do not set this locally.
#
# The runtime ships with no .env, so it reads its whole config (the variables
# above, stored as SecureStrings) from this SSM path at startup. Set by the CDK
# stack, not by you: see the SSM block in agentcore/cdk/lib/cdk-stack.ts.
#
# Unset => runtime_secrets.hydrate() is a no-op and this .env is used, which is
# exactly what you want for local development.
#
# Populate the parameters with:  aws ssm put-parameter --name /leadgen/<NAME> \
#     --value '<value>' --type SecureString --overwrite
# ---------------------------------------------------------------------------
#LEADGEN_SECRETS_PATH=/leadgen/

# ---------------------------------------------------------------------------
# SENDING — off by default.
#
# SEND_BACKEND=none refuses every send and says which setting is missing. That
# is the default on purpose: a build that cannot send must say so rather than
# look configured.
#
#   ses   Amazon SES v2, raw MIME so attachments survive. NOTE: a sandbox
#         account can only send TO addresses verified in that region — check
#         with `aws sesv2 get-account`. Production access is a support request,
#         not a toggle.
#   smtp  Any SMTP host. One setting covers every free provider:
#           Gmail     smtp.gmail.com:587   (an App Password, NOT the account
#                                          password — 2FA required)
#           Brevo     smtp-relay.brevo.com:587
#           Mailjet   in-v3.mailjet.com:587
#           SMTP2GO   mail.smtp2go.com:2525
#         Choosing between them is an edit to this block, not to any code.
#
# An unrecognised value RAISES rather than falling back to none, so a typo
# cannot make a configured build look like a switch that is simply off.
#
# The block below is the PLATFORM MASTER: what a seller who has configured
# nothing of their own sends through. Under Gmail, SEND_FROM_EMAIL must equal
# SMTP_USER — the From is authenticated by the account that logs in, and a
# mismatch is rejected with a message that names the address rather than the
# setting.
#
# A seller can bring their own account under Settings -> Sending (SMTP). That
# is stored per seller in `seller_profile.settings.smtp` (password encrypted at
# rest), not here, and it takes over both the credential and the From for their
# mail. It has to: a From address is authenticated, so a seller's from_email is
# honoured only when they also supplied their own host and user — otherwise the
# platform account would be claiming to be them, which Gmail refuses. A
# seller's display name and Reply-To are not authenticated, so those are always
# theirs, on either account.
# ---------------------------------------------------------------------------
#SEND_BACKEND=none
#SEND_FROM_EMAIL=you@yourdomain.com
#SEND_FROM_NAME=Your Name
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASSWORD=your-app-password

# ---------------------------------------------------------------------------
# UPLOADED FILES — where a resume's BYTES live (the extracted text is in the
# row either way; this is the attachment).
#
#   none      store nothing. Sends go out with no attachment, and the response
#             says `file_stored: false` rather than pretending.
#   supabase  Supabase Storage (the default). Create a PRIVATE bucket named
#             `resumes`; a public one would expose every seller's CV.
#   s3        Any S3-compatible bucket — set FILE_S3_ENDPOINT for R2/MinIO.
#   local     The filesystem, for a machine with no cloud configured.
#
# Same rule as above: an unrecognised value RAISES.
# ---------------------------------------------------------------------------
#FILE_BACKEND=supabase
#FILE_BUCKET=resumes
#FILE_LOCAL_DIR=
#FILE_S3_ENDPOINT=
#FILE_S3_REGION=us-west-2
