# Copy this file to .env and fill in your real values.
# DataForSEO authenticates with HTTP Basic Auth using your account login
# (your email) + password. These are read from the environment (or .env) by
# dataforseo.py and app.py. Never commit the real .env.
DATAFORSEO_LOGIN=your@email.com
DATAFORSEO_PASSWORD=your-dataforseo-password
GROQ_API_KEY=gsk_your-key-here

# Supabase (STORE stage). Project URL looks like https://abcd.supabase.co
# and the SERVICE_ROLE key (Settings -> API) bypasses RLS for internal writes.
# Never commit the real .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...your-service-role-key

# ---------------------------------------------------------------------------
# Social-profile enrichment (optional). When an operator picks platforms to
# deep-fetch (n8n "social_platforms"), these keys unlock richer data. Handlers
# AUTO-SKIP when a key is missing, so this is optional: no-key wins (WhatsApp
# number parse, X oEmbed, Telegram handle) still work.
#   YOUTUBE_API_KEY    -> https://console.cloud.google.com (YouTube Data API v3)
#   TELEGRAM_BOT_TOKEN -> from @BotFather
# ---------------------------------------------------------------------------
#YOUTUBE_API_KEY=
#TELEGRAM_BOT_TOKEN=

# JS-render escalation for walled socials (reuses the Playwright browser).
# When a platform's plain fetch comes back blocked/unverified AND it's in
# SOCIAL_JS_RENDER_PLATFORMS, social_enrich retries it in a headless browser.
# OFF by default (hosting). Default allowlist = the two where a browser clears a
# consent wall; extend the list to try others, e.g. facebook,pinterest,instagram.
# Enable per-platform is automatic once SOCIAL_JS_RENDER=true + listed here.
#ENRICH_JS_RENDER=false            # website-crawl hollow fallback (separate)
#SOCIAL_JS_RENDER=false            # master switch for social JS escalation
#SOCIAL_JS_RENDER_PLATFORMS=facebook,pinterest

# ---------------------------------------------------------------------------
# Scrutiny / data-quality tiers (strict | balanced | lenient).
# All tunable here — the engine reads these at run time. Defaults shown; uncomment
# and change what you want. Threshold = minimum score to qualify. accept_phone_only
# = whether a phone-reachable business (no website) may become a lead.
# HINT = instruction injected into the scoring prompt for that tier.
# ---------------------------------------------------------------------------
SCRUTINY_DEFAULT=strict

SCRUTINY_STRICT_THRESHOLD=70
SCRUTINY_STRICT_ACCEPT_PHONE_ONLY=false

SCRUTINY_BALANCED_THRESHOLD=55
SCRUTINY_BALANCED_ACCEPT_PHONE_ONLY=true

SCRUTINY_LENIENT_THRESHOLD=40
SCRUTINY_LENIENT_ACCEPT_PHONE_ONLY=true

# Optional per-tier scoring-prompt hints. If omitted the built-in defaults are used.
#SCRUTINY_STRICT_HINT=Be strict...
#SCRUTINY_BALANCED_HINT=...
#SCRUTINY_LENIENT_HINT=...

# ---------------------------------------------------------------------------
# Phase 1 -- two-score qualification (opportunity + confidence).
# score == opportunity_score, so the tier THRESHOLD above keeps its meaning.
# confidence_score is clamped to a deterministic cap from data quality (a thin
# scrape can never look high-confidence). By default qualification only uses
# opportunity (preserves prior behaviour). Turn on the confidence floor if you
# also want to refuse high-opportunity leads you're too unsure about.
# ---------------------------------------------------------------------------
#REQUIRE_CONFIDENCE_FLOOR=false
#CONFIDENCE_FLOOR=30

# ---------------------------------------------------------------------------
# Headless JS-render fallback (Playwright). OFF by default so lean containers
# don't need a browser. Turn on ONLY where you've already installed it:
#     pip install playwright
#     playwright install chromium
# When on, only pages whose raw HTML "looks hollow" (JS-driven shells with no
# real text) are rendered headlessly so emails/socials can be found there.
# ---------------------------------------------------------------------------
ENRICH_JS_RENDER=false